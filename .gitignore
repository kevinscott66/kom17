# Секреты и конфигурация
.env
.env.local
.env.*.local
*.env
# Любая ручная копия .env: бэкап секретен ровно так же, как оригинал,
# а шаблоны выше не покрывают ни одну из привычных форм имени.
.env.*
.env-*
*.env.bak*
# ...кроме отслеживаемого шаблона: в нём только имена, без значений.
!.env.example
bot_settings.json
settings.json

