# Токен бота (от @BotFather)
BOT_TOKEN=123456:ABC...

# Webhook — режим для прода: `python -m telegram_invite_bot --mode=webhook`.
# Для локальной разработки есть `--mode=polling`, ему WEBHOOK_URL не нужен.
# Продакшн: https://your-domain.com
# Локаль (ngrok): после "ngrok http 8080" подставь HTTPS URL сюда
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
PORT=8080
# Интерфейс, на котором слушает сервер. По умолчанию 127.0.0.1: перед
# ботом всегда стоит reverse proxy (nginx терминирует TLS и проксирует
# на 127.0.0.1:8080), поэтому слушать все интерфейсы незачем — а на
# хосте без фаервола это обход nginx-овых ACL на /metrics и /readyz.
# 0.0.0.0 нужен только внутри контейнера (Dockerfile ставит его сам).
HOST=127.0.0.1

# SSL (опционально). Без них сервер слушает HTTP — подходит для локального ngrok.
# Для прода с своим доменом укажи пути к сертификатам (например Let's Encrypt).
# SSL_CERT=/etc/letsencrypt/live/your-domain/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/your-domain/privkey.pem

# Доверенные upstream-прокси, чьи X-Forwarded-* заголовки uvicorn будет
# уважать. По умолчанию nginx на том же хосте (127.0.0.1). Расширь
# список, если nginx-sidecar / split-host (например 10.0.0.0/8).
# FORWARDED_ALLOW_IPS=127.0.0.1

# ID владельца бота (для админ-панели)
ADMIN_CHAT_ID=123456789

# R-FIX-011-fp: разрешать действия анонимных админов (кнопка
# "Remain anonymous", sender_chat = id 1087968824 GroupAnonymousBot)
# при условии что getChatAdministrators возвращает >= 1 админа в чате.
# Аудит-лог записывает admin_id=sender_chat.id с anonymous=True. Сними
# в 0/false, если оператор хочет вернуть закрытую посуру (iter-1).
# ALLOW_ANONYMOUS_ADMIN=true

# До 4 дополнительных Telegram ID разработчиков (владельцев бота). Если
# заданы — формируют итоговый set developer_ids; иначе используется
# ADMIN_CHAT_ID. Numbered form сохранена для совместимости с уже
# развёрнутым prod .env — переключение на comma-separated потребовало бы
# редактировать env во время cutover, что мы не хотим.
# DEVELOPER_ID_1=123456789
# DEVELOPER_ID_2=
# DEVELOPER_ID_3=
# DEVELOPER_ID_4=

# ID основной группы (supergroup, отрицательное)
CHAT_ID=-1001234567890

# API DeepSeek для ИИ-помощника (/ask, /ai)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...
# Опциональные настройки модели — Stage 13 typed Settings их читает,
# но без них работают дефолты (deepseek-chat, 60s, 1000 tokens, 0.7).
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_TIMEOUT_SECONDS=60
# DEEPSEEK_MAX_TOKENS=1000
# DEEPSEEK_TEMPERATURE=0.7

# OpenAI API для /ai, /gpt, /chat (T-021) и VIP emoji-voice TTS (T-023 — общий ключ).
# Пусто = handler деградирует в "AI временно недоступен" (i18n: h_ai_not_configured).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Опциональные настройки — без них работают дефолты
# (gpt-4o-mini, 512 max_tokens, 0.7 temperature, 30s timeout,
# 0.001 coin/token). См. ADR 0012.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=512
# OPENAI_TEMPERATURE=0.7
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_COIN_PER_TOKEN=0.001

# Суточный потолок Whisper-расшифровок на одну группу (UTC-день).
# Групповая транскрибация — единственный платный OpenAI-путь без цены
# для пользователя: админ включает её, и каждое голосовое в чате
# становится оплаченным вызовом с ключа владельца. /ai, /ask и /voice
# закрыты AiQuotaService, здесь же квоты не было. 0 = без лимита
# (та же конвенция, что у AiQuotaConfig). Дефолт 200 — обычная группа
# столько голосовых за сутки не шлёт, потолок бьёт только по абьюзу.
# OPENAI_STT_GROUP_DAILY_LIMIT=200
# Whisper bills per second of audio, so the call ceiling above does not
# bound the bill on its own: reject a single voice longer than this, and
# cap the audio one group can spend per UTC day. 0 = unlimited.
# OPENAI_STT_MAX_VOICE_SECONDS=300
# OPENAI_STT_GROUP_DAILY_SECONDS=3600
# #1938: оба потолка выше — на группу, а группа не стоит ничего. Любой
# создаёт чат, добавляет бота, включает транскрибацию (нужно быть
# админом, а создатель им и является) и получает свежий бюджет: 50
# чатов = 50 часов оплаченного аудио в сутки, и ни один счётчик не
# превышен. Этот потолок считает секунды по ГОВОРЯЩЕМУ сразу по всем
# чатам, поэтому новые группы ничего не дают. 0 = без лимита. Дефолт
# 1800 — полчаса аудио в сутки от одного человека, это 60-180
# голосовых, то есть далеко за пределами обычного пользования.
# OPENAI_STT_USER_DAILY_SECONDS=1800

# T-023: OpenAI TTS для VIP emoji-voice (/voice). Использует тот же
# OPENAI_API_KEY, что и /ai (T-021). Без него handler рендерит
# h_voice_not_configured. Дефолты: голос nova, модель tts-1, 0.001
# монеты/символ, 60s timeout, 4096 chars cap. См. ADR 0013.
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_COIN_PER_CHAR=0.001
# OPENAI_TTS_TIMEOUT_SECONDS=60
# OPENAI_TTS_MAX_CHARS=4096
# M-P-3: safety cap on upstream audio bytes (default 25MB).
# OPENAI_TTS_MAX_AUDIO_BYTES=26214400
# #1963: суточный потолок /voice для VIP. 0 — без ограничения.
# Раньше число было зашито в код и менялось только редеплоем.
# OPENAI_TTS_VIP_DAILY_LIMIT=20
# Если ON — handler пропускает списание монет для VIP-пользователей
# (out-of-band promo / VIP-tier подарок). По умолчанию OFF: VIP
# платит как обычно, VIP-gate сам по себе — это барьер входа.
# VIP_UNLIMITED_VOICE=false
# M-P-4: comma-separated user IDs of the top VIP tier that receives
# free /voice when VIP_UNLIMITED_VOICE=true. Empty → no one gifted.
# VIP_UNLIMITED_VOICE_USER_IDS=

# RR-6 #72: аварийный выключатель онлайн-источников /joke (JokeAPI,
# icanhazdadjoke, Lingva). Все три — бесплатные сторонние API без
# договора с нами; если один начнёт лимитировать, тормозить или отдавать
# мусор, флаг возвращает команду на локальный пул БЕЗ передеплоя.
# По умолчанию OFF — онлайн-источник и есть фича.
# JOKE_OFFLINE_ONLY=false

# M-P-2 / L-69: per-user daily AI quota (resets at 00:00 UTC).
# Defaults: free=10/day, vip=200/day. A ceiling of 0 means unlimited
# for that tier (no cap, no rejection) — do NOT put 0 on the VIP tier
# unless you mean it: /ai, /ask, /voice and /quote cost the user
# nothing, so every request is billed to the operator's provider key
# and this counter is the only per-day ceiling that exists.
# AI_QUOTA_FREE_DAILY_LIMIT=10
# AI_QUOTA_VIP_DAILY_LIMIT=200
# Comma-separated Telegram user IDs that bypass the quota entirely.
# AI_QUOTA_DEV_USER_IDS=

# Погода ключа не требует. /weather и /forecast ходят в Open-Meteo
# (geocoding-api.open-meteo.com + api.open-meteo.com), см.
# services/weather_service.py. Поля OPENWEATHER_API_KEY в Settings
# больше нет, а префикс OPENWEATHER_ намеренно оставлен в
# _SEED_ENV_PREFIXES — так что переменная в .env ничего не включает,
# зато попадает в предупреждение о лишних переменных на старте.

# exchangerate-api.com для /rate, /convert (конвертация COM→валюта).
# Необязательно: если ключ задан — используется платный v6-эндпоинт
# (https://v6.exchangerate-api.com/v6/<key>/latest/USD), иначе бесплатный
# v4. COM/RUB фиксированы, крипто берётся из встроенной таблицы.
# EXCHANGERATE_API_KEY=...
# CURRENCY_TIMEOUT_SECONDS=10
# CURRENCY_CACHE_TTL_SECONDS=3600

# Канал для логов (ERROR/CRITICAL)
LOG_BOT_CHAT_ID=-1001234567890

# Путь к settings.json (опционально). Чтобы настройки не сбрасывались при обновлении папки — укажи вне проекта:
# SETTINGS_FILE=/var/lib/telegram-bot/settings.json

# Папка для всех баз данных и user_cities.json — хранится отдельно от кода. Можно обновлять папку проекта целиком.
# Один раз на сервере: sudo mkdir -p /var/lib/telegram-bot && sudo chown $USER:$USER /var/lib/telegram-bot
# При первом переносе скопируй туда текущие базы: cp database/*.db /var/lib/telegram-bot/
DATABASE_DIR=/var/lib/telegram-bot
# Статистика сообщений по умолчанию в DATABASE_DIR (message_stats.db). Отдельная папка при необходимости:
# MESSAGE_STATS_DIR=/var/lib/telegram-bot/message_stats

# Отображаемое имя в Telegram всегда «Ком17 — Beta {текущая версия} ✞» (меняется только число).
# @username не меняется. Синхронизация при старте и после /reload. Локально отключить:
# DISABLE_TELEGRAM_NAME_SYNC=1

# Редактор полных гайдов команд на сайте: GET/POST {WEBHOOK_URL}/commands/edit
# В POST передай поле secret с этим значением (или заголовок X-Guides-Secret).
# Пока переменная не задана, страница редактора отвечает 404 (а не «сохранение
# отключено»): на этом же домене лежат оферта и политика — админ-форма, открытая
# всем, читается проверяющим как незакрытая админка. Задай секрет — и страница
# появится. Сохранённый текст сразу становится содержимым /commands.
# GUIDES_EDIT_SECRET=случайная_строка

# =============================================================================
# Новая архитектура (strangler-рефакторинг) — добавлено в Этапе 0
# =============================================================================

# Окружение: dev | staging | prod. В prod включается db/safety.py (запрет DELETE/UPDATE без WHERE).
APP_ENV=dev

# Уровень логирования: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# JSON-формат логов (для парсера на стороне аггрегатора). По умолчанию —
# человекочитаемый text-формат. Переключай в 1 на проде, если логи
# уходят в Loki/ELK; 0/пусто оставляй для dev.
# LOG_JSON=0

# Папка для логов. По умолчанию ``logs/`` рядом с процессом; в проде
# обычно ``/var/log/telegram-bot`` (отдельный том, rotate настраивай
# на стороне systemd/logrotate).
# LOGS_DIR=logs

# Sentry DSN (опционально). Пусто = Sentry выключен.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Share of transactions sampled for performance traces, 0.0-1.0.
# 0.0 (the default) means errors only. Raise it during an incident
# to capture spans, then put it back — traces burn Sentry quota.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Секрет для валидации Telegram webhook (заголовок X-Telegram-Bot-Api-Secret-Token).
# Сгенерируй случайную строку 32+ символов: openssl rand -hex 32
# Передаётся в setWebhook(secret_token=...) при старте.
# ОБЯЗАТЕЛЬНО при APP_ENV=prod — Settings падает на старте, если пусто
# (Stage 78: блокирует webhook-forgery, когда verify_secret_token иначе
# был бы no-op).
WEBHOOK_SECRET_TOKEN=

# Явное согласие запустить webhook без секрета (по умолчанию false).
# Без него старт падает: публичный URL без WEBHOOK_SECRET_TOKEN
# принимает поддельные апдейты от кого угодно, а раньше об этом лишь
# писалось в лог — и такой деплой работал как ни в чём не бывало.
# Ставить только для туннеля на машину разработчика; с APP_ENV=prod
# не поможет, там секрет обязателен на уровне Settings.
# ALLOW_INSECURE_WEBHOOK=false

# ENABLE_NEW_PIPELINE больше не существует: strangler-мост убран в
# T-011, прод запускается как `python -m telegram_invite_bot
# --mode=webhook` (docs/DEPLOY.md), и legacy-юнита, от которого
# можно было бы переключаться, не осталось. Как и OPENWEATHER_API_KEY
# выше, переменная в .env даёт теперь только предупреждение на старте.

# /help и /faq — страница с полным списком команд. Имя переменной
# осталось от Telegraph, но указывать теперь надо на собственный сайт:
# /commands генерируется из того же каталога команд, что и /help, и
# поэтому не может разойтись с ботом (Telegraph-копия расходилась).
# Если оба пусты — inline-кнопка не рендерится (поведение legacy).
# TELEGRAPH_COMMANDS_URL=https://tgbot.delabs.space/commands
# TELEGRAPH_COMMANDS_URL_EN=https://tgbot.delabs.space/commands/en

# /stats — окно агрегации (дней, 1..365) и TZ для границы календарного
# дня. Legacy использовал date('now') (server-local, недокументировано);
# новый pipeline фиксирует TZ явно. По умолчанию 7 дней / Europe/Moscow.
# STATS_PERIOD_DAYS=7
# STATS_TIMEZONE=Europe/Moscow

# Per-user throttling (token-bucket). Defaults — burst 10, sustained
# 2/sec (~120/мин) — комфортны для людей и режут флуд-ботов до того,
# как они достигнут handler'ов и outbound-rate-limit Telegram'а.
# Метрика-сигнал: tib_throttled_total{event_type=...}. Capacity вверх,
# если ругаются обычные пользователи; refill вниз — если виден
# устойчивый ненулевой counter на реальных user_id.
# THROTTLE_ENABLED=1
# THROTTLE_CAPACITY=10
# THROTTLE_REFILL_PER_SECOND=2.0
# THROTTLE_MAX_TRACKED_USERS=10000

# Автоуборка игровых карточек в группах (RR-3 #33). Legacy удалял ЛЮБОЙ
# ответ игры через 30 сек; у нас карточка теперь несёт баланс, новые
# достижения и остаток попыток — люди к ней возвращаются, поэтому по
# умолчанию OFF. Включай точечно, если в группе игры забивают чат.
# В личке уборка не работает никогда. TTL — секунды (минимум 5).
# GAMES_AUTO_DELETE=0
# GAMES_MESSAGE_TTL=30

# /commands и /commands/en — публичная HTML-страница с гайдом по командам
# (cms.guide_site). По умолчанию включена; sources_dir — каталог с
# telegraph_guide_ru.md и telegraph_guide_en.md (по умолчанию — корень
# репо для legacy-парити). site_title — отображаемое имя бота в шапке.
# GUIDE_SITE_ENABLED=1
# GUIDE_SITE_SOURCES_DIR=.
# GUIDE_SITE_TITLE=ком17

# Юридические документы: /privacy, /terms, /support (и /en у каждого).
# Страницы монтируются ВСЕГДА и выключателя не имеют — банк-эквайер
# требует постоянной доступности оферты и политики. Переменные ниже
# только подставляют реквизиты в текст; без них документы работают,
# но вместо оператора будет подставлено GUIDE_SITE_TITLE, а из
# контактов останется только тикет-система бота (/support).
#
# SUPPORT_USERNAME — telegram-хендлер поддержки, с @ или без; кладётся
# в текст как ссылка t.me и на inline-кнопку в боте. Некорректное
# значение (пробелы, ссылка целиком) молча игнорируется — кнопки просто
# не будет, битой ссылки в оферте не появится.
# SUPPORT_USERNAME=kom17_support
# SUPPORT_EMAIL=support@example.com
#
# LEGAL_OPERATOR_NAME — кто в оферте является стороной договора
# (ИП/ООО/физлицо). LEGAL_OPERATOR_DETAILS — реквизиты одной строкой
# (ИНН/ОГРНИП/адрес); показываются в разделе контактов.
#
# ВНИМАНИЕ: значения ниже — ОБРАЗЕЦ ФОРМАТА, а не данные: нули и
# «Фамилия Имя Отчество» показывают только, что и в каком порядке
# писать. Перед тем как отдавать ссылки на /terms и /privacy эквайеру,
# сюда должны попасть настоящие реквизиты — иначе оператором в оферте
# останется GUIDE_SITE_TITLE (сейчас на проде так и есть: «Оператор:
# ком17»). Пустое поле честнее выдуманного юрлица, поэтому фолбэк
# именно такой, но для банка он не подойдёт.
# LEGAL_OPERATOR_NAME=ИП Фамилия Имя Отчество
# LEGAL_OPERATOR_DETAILS=ИНН 000000000000, ОГРНИП 000000000000000

# Aiogram FSM storage backend (T-012). ``memory`` keeps state in
# process RAM (default; lost on restart — fine for dev). ``sqlite``
# persists state to ``FSM_SQLITE_PATH`` so /cpc and other multi-turn
# flows survive a deploy. The SQLite file is independent of the
# business engines in ``database/`` — ``rm database/fsm.db`` is a
# safe recovery action.
# FSM_BACKEND=memory
# FSM_SQLITE_PATH=database/fsm.db

# Economy tunables. ``REFERRAL_COMMISSION_PERCENT`` is the cut an
# inviter receives on coin purchases by their invitees, rendered by
# /referral. Legacy reads the same value from ``bot_settings.json``;
# default 10 mirrors the legacy fallback so the two pipelines stay
# in sync during the strangler window.
# REFERRAL_COMMISSION_PERCENT=10
# ``DEVELOPER_COMMISSION_PERCENT`` (#75): the developer wallet's cut of
# every purchase/top-up (legacy bot.py:3173; recipient = ADMIN_CHAT_ID).
# DEVELOPER_COMMISSION_PERCENT=5
# ``PURCHASE_DONATION_TO_GROUP_PERCENT`` (RR-2 #14): the slice of a
# /shop purchase made "for a group" that is routed to that group —
# it becomes rating points (group_xp) on the donations leaderboard,
# and the group's creator is paid that amount minus the developer cut
# (legacy bot.py:2562 / bot.py:13240). Set to 0 to disable group
# routing entirely; the group chooser then disappears from /shop.
# PURCHASE_DONATION_TO_GROUP_PERCENT=15
# ``COINS_TRANSFER_TAX`` (#193): the cut /send takes off the top,
# as a fraction 0..1 (0.05 = 5%), credited to ADMIN_CHAT_ID exactly
# as legacy does (bot.py:10270-10273). Default 0 = no tax, matching
# the legacy default (bot.py:2550). Leave ADMIN_CHAT_ID unset and a
# non-zero tax is burned instead of banked — the ledger records that
# honestly as ``transfer_tax_burned``.
# COINS_TRANSFER_TAX=0
# ``ANTI_ABUSE_NEW_USER_NO_DAILY_HOURS`` (#1946): a wallet younger
# than this many hours cannot claim /daily, so throwaway accounts
# minted to farm the bonus get nothing. Default 0 = off, exactly as
# legacy defaulted it (bot.py:3880, guard at bot.py:12024); this
# deployment has never carried a settings.json that set it, so
# switching it on is an operator decision. Developers listed in
# DEVELOPER_IDS are exempt, as they were in legacy.
# ANTI_ABUSE_NEW_USER_NO_DAILY_HOURS=0
# ``GROUP_TREASURY_MIN_WITHDRAWAL`` (L-41): min /group_pay payout
# (legacy bot.py:2563).
# GROUP_TREASURY_MIN_WITHDRAWAL=1000
# ``DONATE_*`` (#2007): /donate — a member donates coins to the group
# they are writing in. The sum becomes the group's rating score and the
# chat creator is paid it minus DEVELOPER_COMMISSION_PERCENT. Legacy
# carried all three as constants (bot.py:10568-10570). The cooldown is
# per (user, group) and is stamped only after a donation succeeds, so a
# refused attempt never costs the next window.
# DONATE_MIN_AMOUNT=1
# DONATE_MAX_AMOUNT=1000000
# DONATE_COOLDOWN_SECONDS=10
# ``P2P_PENDING_TTL_MINUTES`` (P2P D2): pending P2P trades auto-cancel
# after this many minutes; the COM slice returns to the order.
# P2P_PENDING_TTL_MINUTES=30
# ``PVP_OFFER_TTL_MINUTES`` (#267): an unanswered PvP challenge holds
# the creator's stake, so it expires much sooner than a P2P trade.
# Legacy used 600s (bot.py:3782); the port briefly rode the P2P knob.
# PVP_OFFER_TTL_MINUTES=10
# ``ADS_REQUEST_COOLDOWN_HOURS`` (L-61): per-user cooldown between /ad
# advertiser requests (legacy 24h, bot.py:2797).
# ADS_REQUEST_COOLDOWN_HOURS=24

# Passive per-message earning + the global switch (A-03). Every
# qualifying group message credits its author ``COINS_MESSAGE_REWARD``
# coins, gated globally by ``COINS_ENABLED`` and throttled in-process by
# the anti-spam heuristic below — a message earns at most once per
# ``MESSAGE_REWARD_COOLDOWN_SEC``, no more than
# ``MESSAGE_REWARD_MAX_PER_MINUTE`` times in any trailing 60s, never
# twice for the same text within ``MESSAGE_REWARD_DUPLICATE_WINDOW_SEC``,
# and only when it has at least ``MESSAGE_REWARD_MIN_CHARS`` non-space
# characters. Defaults mirror the legacy ``should_reward_message`` gate.
# COINS_ENABLED=true
# COINS_MESSAGE_REWARD=1
# MESSAGE_REWARD_MIN_CHARS=8
# MESSAGE_REWARD_COOLDOWN_SEC=20
# MESSAGE_REWARD_MAX_PER_MINUTE=3
# MESSAGE_REWARD_DUPLICATE_WINDOW_SEC=120
# ``MESSAGE_REWARD_DAILY_CAP`` (T-019, R1): the per-user, per-day ceiling
# on coins earned this way. The other gates are all rate limits, which
# bound coins *per minute* but not per day — 3/min is 4320 COM/day, close
# to the whole withdrawal cap, minted from nothing. A normal chatter
# never reaches 150; a script is stopped dead. Set 0 to disable the cap
# (restores the pre-T-019 unbounded behaviour). See
# docs/ECONOMY_RATE_AUDIT.md §2.1.
# MESSAGE_REWARD_DAILY_CAP=150
# Coin-check subscription gate (FEAT-CHECKSUB): the channel (@username or
# -100… id) a user must be subscribed to before claiming a check created
# with required_subscription. Unset → the gate is a no-op (claims proceed).
# CHECK_SUBSCRIPTION_CHANNEL=@your_channel

# Withdrawal tunables (#28, T-027). ``WITHDRAW_MIN_COINS`` /
# ``WITHDRAW_MAX_COINS`` bound the amount the /withdraw FSM accepts (in
# coins); ``WITHDRAW_COINS_PER_USDT`` is the conversion rate used to
# quote the crypto payout (default 900 coins = 1 USDT); ``WITHDRAW_ASSET``
# is the Crypto Pay asset transferred on admin approval. Defaults match
# the legacy economy so the strangler pipelines agree.
# WITHDRAW_MIN_COINS=4500
# WITHDRAW_MAX_COINS=90000
# WITHDRAW_COINS_PER_USDT=900
# WITHDRAW_ASSET=USDT
# ``WITHDRAW_DAILY_LIMIT_COINS`` / ``WITHDRAW_MONTHLY_LIMIT_COINS`` (L-92):
# per-user rolling caps; usage is derived live from request timestamps so
# the window self-resets at the day/month boundary.
# WITHDRAW_DAILY_LIMIT_COINS=10000
# WITHDRAW_MONTHLY_LIMIT_COINS=100000
# ``WITHDRAW_REQUIRE_DEPOSIT`` (T-019, R2): when on (the default), an
# account may only cash out to USDT once it has at least one ``purchase_*``
# ledger row — i.e. real money entered at some point. Minted coins keep
# full in-ecosystem utility (shop, /send, games, /daily); they just can't
# be exported. Turn it off to honour balances grown before the gate
# existed. See docs/ECONOMY_RATE_AUDIT.md §7.3.
# WITHDRAW_REQUIRE_DEPOSIT=true
# ``WITHDRAW_PAYOUT_RATIO`` (T-020, R6): the bound the flag above does NOT
# provide. REQUIRE_DEPOSIT is a threshold — it asks whether money ever came
# in, not how much, so one top-up unlocks unlimited winnings on the way
# out. This caps lifetime payout at ``lifetime_deposits * ratio`` coins.
# 1.0 (the default) = a user cashes out exactly what they paid in, never
# more, with a full unpenalised exit for every honest buyer. Raise it to
# hand back winnings (1.5 = up to 150 %); 0 disables the cap entirely
# (same "0 means off" convention as MESSAGE_REWARD_DAILY_CAP). Note that
# both knobs must be off to restore pre-T-019 behaviour.
# See docs/ECONOMY_RATE_AUDIT.md §8.1.
# WITHDRAW_PAYOUT_RATIO=1.0


# Payment provider secrets (T-025). Each one gates whether the
# matching webhook endpoint accepts deliveries — when unset, the
# corresponding /crypto-webhook / /yookassa-webhook / /stripe-webhook
# returns 503 (service degraded) with a single log line. All four
# are needs-human: real values must be injected at deploy time via
# the operator's secret-management workflow and MUST NOT be checked
# into the repo. Names match the legacy ``.env`` so the same prod
# secret store works through the cutover.
# CRYPTO_PAY_TOKEN=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# RollyPay (rollypay.io) — the only fiat provider with a complete
# in-bot cycle: the bot mints the payment itself and hands the user a
# pay button (SBP / card / crypto), then credits from the signed
# callback. It therefore needs TWO secrets, and they are NOT
# interchangeable:
#
#   ROLLYPAY_API_KEY        outbound  — sent as ``X-API-Key`` when the
#                                       bot creates a payment. Missing
#                                       ⇒ the /topup row renders the
#                                       "checkout unavailable" copy.
#   ROLLYPAY_SIGNING_SECRET inbound   — HMAC-SHA256 key that verifies
#                                       ``X-Signature`` on the callback.
#                                       Missing ⇒ /rollypay-webhook 503.
#
# Setting only the API key would give a bot that can take money but
# cannot credit it, so the checkout is gated on BOTH being present:
# with one half set the /topup row renders as unavailable and no
# payment page is ever minted (``build_rollypay_topup_service``).
# Set both or neither. Unlike YooKassa, RollyPay signs
# its callbacks, so there is no reverify-by-API hop — which also means
# a leaked signing secret is directly mintable: treat it as a wallet
# key, not as a config value.
# ROLLYPAY_API_KEY=
# ROLLYPAY_SIGNING_SECRET=

# EPIC ranks: автоповышение TG-админов до ранга 2 (легаси staff-sync).
# По умолчанию ВЫКЛ — действует только понижение при потере админки.
# RANK_AUTOSYNC=0
